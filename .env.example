# PostgreSQL connection string from Railway PostgreSQL service
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
PORT=3001

# Main administrator credentials (set different strong values in Railway)
ADMIN_USERNAME="manager"
ADMIN_PASSWORD="CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD"

# Random secret, at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Backblaze B2 (legacy: used only to display files in older reports)
B2_KEY_ID="your_application_key_id"
B2_APPLICATION_KEY="your_application_key"
B2_BUCKET_NAME="parkrate"
B2_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
B2_REGION="eu-central-003"

# Cloudinary (new employee report photos/videos)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String     @id @default(cuid())
  name      String
  address   String?
  city      String?
  active    Boolean    @default(true)
  employees Employee[]
  invites   EmployeeInvite[]
  applications EmployeeApplication[]
  createdAt DateTime   @default(now())
}

model Employee {
  id          String         @id @default(cuid())
  fullName    String
  phone       String?
  login       String?        @unique
  passwordHash String?
  birthDate   DateTime?
  position    String?
  hireDate    DateTime?
  status      String         @default("Работает")
  notes       String?
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id])
  rates       EmployeeRate[]
  shifts      Shift[]
  activation  EmployeeActivation?
  tasks       Task[]
  locationSelections LocationSelection[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ShiftType {
  id        String         @id @default(cuid())
  name      String
  active    Boolean        @default(true)
  rates     EmployeeRate[]
  shifts    Shift[]
  createdAt DateTime       @default(now())
}

model EmployeeRate {
  id          String    @id @default(cuid())
  employeeId  String
  shiftTypeId String
  amount      Decimal   @db.Decimal(12, 2)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)
  @@unique([employeeId, shiftTypeId])
}

model Shift {
  id            String    @id @default(cuid())
  employeeId    String
  shiftTypeId   String
  workDate      DateTime
  startedAt     String?
  endedAt       String?
  amount        Decimal   @db.Decimal(12, 2)
  comment       String?
  status        String    @default("Подтверждена")
  employee      Employee  @relation(fields: [employeeId], references: [id])
  shiftType     ShiftType @relation(fields: [shiftTypeId], references: [id])
  createdAt     DateTime  @default(now())
}


model EmployeeInvite {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())
  applications EmployeeApplication[]
}

model EmployeeApplication {
  id        String   @id @default(cuid())
  inviteId  String
  invite    EmployeeInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  birthDate DateTime?
  position  String?
  hireDate  DateTime?
  notes     String?
  status    String   @default("На проверке")
  reviewedAt DateTime?
  createdAt DateTime @default(now())
}


model EmployeeActivation {
  id        String   @id @default(cuid())
  employeeId String @unique
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model Task {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  status      String   @default("Новое")
  employeeComment String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Location {
  id        String   @id
  region    String
  latitude  Float
  longitude Float
  city      String
  district  String
  province  String
  selections LocationSelection[]
  createdAt DateTime @default(now())
  @@index([city])
  @@index([region])
}

model LocationSelection {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  status      String   @default("На проверке")
  adminComment String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, createdAt])
  @@index([employeeId, status])
  @@index([locationId, status])
}


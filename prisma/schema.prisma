generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String     @id @default(cuid())
  name      String
  address   String?
  active    Boolean    @default(true)
  employees Employee[]
  createdAt DateTime   @default(now())
}

model Employee {
  id          String         @id @default(cuid())
  fullName    String
  phone       String?
  birthDate   DateTime?
  position    String?
  hireDate    DateTime?
  status      String         @default("Работает")
  notes       String?
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id])
  rates       EmployeeRate[]
  shifts      Shift[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ShiftType {
  id        String         @id @default(cuid())
  name      String
  active    Boolean        @default(true)
  rates     EmployeeRate[]
  shifts    Shift[]
  createdAt DateTime       @default(now())
}

model EmployeeRate {
  id          String    @id @default(cuid())
  employeeId  String
  shiftTypeId String
  amount      Decimal   @db.Decimal(12, 2)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)
  @@unique([employeeId, shiftTypeId])
}

model Shift {
  id            String    @id @default(cuid())
  employeeId    String
  shiftTypeId   String
  workDate      DateTime
  startedAt     String?
  endedAt       String?
  amount        Decimal   @db.Decimal(12, 2)
  comment       String?
  status        String    @default("Подтверждена")
  employee      Employee  @relation(fields: [employeeId], references: [id])
  shiftType     ShiftType @relation(fields: [shiftTypeId], references: [id])
  createdAt     DateTime  @default(now())
}
